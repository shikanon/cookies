# Local development only. Never commit real credentials to .env.
COOKIES_ENV=local
COOKIES_HTTP_ADDR=:8080
COOKIES_MYSQL_DATABASE=cookies
COOKIES_MYSQL_USER=cookies
COOKIES_MYSQL_PASSWORD=cookies_local_development_only
COOKIES_MYSQL_ROOT_PASSWORD=root_local_development_only
COOKIES_MYSQL_PORT=3307
COOKIES_MYSQL_DSN=cookies:cookies_local_development_only@tcp(127.0.0.1:3307)/cookies?parseTime=true&multiStatements=true
# Keep local MySQL bounded on small Docker/WSL hosts. Increase deliberately for
# larger datasets instead of allowing multiple worktrees to consume all memory.
COOKIES_MYSQL_MEMORY_LIMIT=640m
COOKIES_MYSQL_INNODB_BUFFER_POOL_SIZE=192M
COOKIES_MYSQL_MAX_SERVER_CONNECTIONS=40
COOKIES_BLOB_PROVIDER=filesystem
COOKIES_FILESYSTEM_BLOB_ROOT=.data/blobs
# Optional directory containing reviewed .pdf and .mp4 assets to import into
# the canonical investor-demo project during `npm run go:seed`.
COOKIES_DEMO_DATA_DIR=

# Optional read-only Ocean Engine web_api session connector. Keep the master key
# blank here; generate and store it only in a local ignored .env or deployment secret.
COOKIES_OCEAN_ENGINE_ENABLED=false
COOKIES_OCEAN_ENGINE_BASE_URL=https://ad.oceanengine.com
COOKIES_OCEAN_ENGINE_BUSINESS_BASE_URL=https://business.oceanengine.com
COOKIES_OCEAN_ENGINE_MASTER_KEY=
COOKIES_OCEAN_ENGINE_MASTER_KEY_VERSION=v1
COOKIES_OCEAN_ENGINE_PATROL_ENABLED=false
COOKIES_OCEAN_ENGINE_PATROL_INTERVAL_HOURS=24
COOKIES_OCEAN_ENGINE_PATROL_LOOKBACK_DAYS=14
COOKIES_OCEAN_ENGINE_WEB_API_WRITE_ENABLED=false
COOKIES_OCEAN_ENGINE_WEB_API_WRITE_ACCOUNT_ALLOWLIST=

# Local first-login account. These defaults are rejected outside local/test.
COOKIES_PASSWORD_AUTH_ENABLED=true
COOKIES_ADMIN_USERNAME=Admin
COOKIES_ADMIN_PASSWORD=123456
COOKIES_SESSION_HOURS=8
# Root Vite frontend keeps browser traffic same-origin. Password login and the
# HttpOnly session cookie use the Go /platform API.
VITE_API_BASE_URL=
VITE_COMPAT_API_PROXY_TARGET=http://127.0.0.1:8787
VITE_PLATFORM_PROXY_TARGET=http://127.0.0.1:8080

# Compatibility MVP login only. These are deliberately non-production demo
# credentials; the Go /platform/v1 local flow uses COOKIES_LOCAL_* identity
# injection instead of a password login.
COOKIES_DEMO_EMAIL=demo@cookies.local
# Set locally; do not commit a password value.
COOKIES_DEMO_PASSWORD=

# TOS object storage is optional for local development. Leave all credentials
# blank in .env; do not commit a populated .env file. OBJECT_STORAGE_* names
# remain supported for deployments migrating to the COOKIES_TOS_* names.
COOKIES_TOS_ENDPOINT=
COOKIES_TOS_REGION=
COOKIES_TOS_ACCESS_KEY=
COOKIES_TOS_SECRET_KEY=
COOKIES_TOS_SECURITY_TOKEN=
# One private bucket is split by the quarantine/, assets/, and provider-output/
# object-key prefixes. Older per-purpose bucket variables remain supported for
# deployments that have not migrated yet.
COOKIES_TOS_BUCKET=

# Optional local full-loop identity. With these values the API seeds an active
# project and enables the Fake Provider + Generated Intake workers.
COOKIES_LOCAL_ORGANIZATION_ID=org_local
COOKIES_LOCAL_PRINCIPAL_KIND=user
COOKIES_LOCAL_PRINCIPAL_ID=user_local
COOKIES_LOCAL_PROJECT_ID=project_local
COOKIES_LOCAL_SCOPES=project.read,project.write,assets.read,assets.write,provider.job.create,provider.text.generate,provider.vision.understand,creative.read,creative.write,strategy.read,strategy.write,strategy.confirm,strategy.review,strategy.approve,strategy.package.read,delivery.read,delivery.write,delivery.approve,delivery.execute,insights.read,insights.write,insights.confirm

# Provider M1 stays local-only. Keep fake as the default. Text and audio are
# also the runtime selectors used by multimodal material understanding:
# real vision requires text=adapter_gateway; real ASR requires
# audio=volcengine_asr. The browser Settings page does not populate either
# configuration yet. To call the shared gpt-image-2 Adapter, use
# adapter_gateway and run
# .\scripts\configure-adapter-image.ps1 once; it asks for the Adapter token
# interactively and writes only encrypted credential material to local MySQL.
# Never put that Adapter token in this file.
COOKIES_PROVIDER_IMAGE_ADAPTER=fake
# Real video generation must use the shared Adapter; direct provider video
# connections are intentionally rejected by configuration validation.
COOKIES_PROVIDER_VIDEO_ADAPTER=fake
COOKIES_PROVIDER_TEXT_ADAPTER=fake
COOKIES_PROVIDER_AUDIO_ADAPTER=fake
COOKIES_PROVIDER_SPEECH_ADAPTER=fake
# Run scripts/configure-minimax-speech.ps1 to store the MiniMax key encrypted
# in MySQL and switch this value to minimax_speech.
COOKIES_VOLCENGINE_SPEECH_ENDPOINT=https://openspeech.bytedance.com/api/v3/tts/unidirectional
COOKIES_VOLCENGINE_SPEECH_API_KEY=
COOKIES_VOLCENGINE_SPEECH_RESOURCE_ID=seed-tts-2.0
COOKIES_VOLCENGINE_SPEECH_DEFAULT_VOICE=
COOKIES_AI_AD_MAX_ACTIVE_UNITS=2

# Optional local media toolchain. Existing image/text features still start
# when these paths are empty; MP4 validation and rendering remain unavailable.
COOKIES_FFMPEG_PATH=
COOKIES_FFPROBE_PATH=
COOKIES_VIDEO_WORK_ROOT=.data/video-work

# Multimodal material understanding rolls out independently from Strategy.
# Real vision requires COOKIES_PROVIDER_TEXT_ADAPTER=adapter_gateway, a stable
# COOKIES_PROVIDER_MASTER_KEY, and an enabled MySQL Provider Gateway route for
# capability=vision.understand whose alias matches the value below. The routed
# upstream model must accept OpenAI-compatible image_url chat input.
# Real ASR requires COOKIES_PROVIDER_AUDIO_ADAPTER=volcengine_asr, an available
# COOKIES_FFMPEG_PATH (or ffmpeg on PATH), and the Volcengine credentials later
# in this file. These are startup/deployment settings and currently are not
# written by the compatibility Settings page. When ASR is disabled,
# speech-dependent content styles remain unknown instead of being guessed.
COOKIES_MEDIA_UNDERSTANDING_REAL_PROVIDER_ENABLED=false
COOKIES_MEDIA_UNDERSTANDING_VISION_MODEL_ALIAS=cookies.vision.standard
COOKIES_MEDIA_UNDERSTANDING_ASR_ENABLED=false

# Creative short-drama and game-preroll planning. Models produce only
# structured candidate outlines; the server validates evidence and compiles PromptPackage.
# Invalid or unavailable model output falls back to the deterministic planner.
COOKIES_CREATIVE_SHORT_DRAMA_MODEL_PLANNER_ENABLED=true
COOKIES_CREATIVE_SHORT_DRAMA_PLANNER_MODEL_ALIAS=cookies.text.standard
COOKIES_CREATIVE_GAME_PREROLL_MODEL_PLANNER_ENABLED=true
COOKIES_CREATIVE_GAME_PREROLL_PLANNER_MODEL_ALIAS=cookies.text.standard
COOKIES_CREATIVE_BRAND_FILM_MODEL_PLANNER_ENABLED=true
COOKIES_CREATIVE_BRAND_FILM_PLANNER_MODEL_ALIAS=cookies.text.standard
# CreativeDirection is the first Creative-authored LLM stage. Keep disabled
# until route-level quality evaluation and product rollout are approved.
COOKIES_CREATIVE_DIRECTION_PLANNING_ENABLED=false
COOKIES_CREATIVE_DIRECTION_PLANNER_MODEL_ALIAS=cookies.text.standard
# Deterministic image-text composition requires a pinned TTF, OTF or TTC font.
# The checksum is required whenever the renderer is enabled; TTC files use the first font face.
COOKIES_CREATIVE_IMAGE_FONT_PATH=
COOKIES_CREATIVE_IMAGE_FONT_SHA256=

# Strategy rollout. Real Provider calls require adapter_gateway; approval can
# be disabled independently. Strategy-to-Creative is an explicit user action:
# it reads an immutable package and creates a Creative Intake, never a task.
COOKIES_STRATEGY_ENABLED=true
COOKIES_STRATEGY_V2_ENABLED=true
COOKIES_STRATEGY_REAL_PROVIDER_ENABLED=false
COOKIES_STRATEGY_APPROVE_ENABLED=true
COOKIES_STRATEGY_PACKAGE_TO_CREATIVE_ENABLED=true
COOKIES_STRATEGY_CREATIVE_TASK_PLANNING_ENABLED=true
COOKIES_STRATEGY_TEXT_MODEL_ALIAS=cookies.text.standard
COOKIES_STRATEGY_LITE_TEXT_MODEL_ALIAS=cookies.text.lite
COOKIES_STRATEGY_DEEP_REVIEW_MODEL_ALIAS=cookies.text.deep_review
# To reuse the encrypted Adapter credential and route this alias to GPT-5.5:
# powershell -ExecutionPolicy Bypass -File scripts/configure-gpt55-text.ps1
COOKIES_STRATEGY_PROMPT_VERSION=strategy.generate.v2
COOKIES_STRATEGY_CREATIVE_TASK_PROMPT_VERSION=strategy.creative_task.generate.v2
COOKIES_STRATEGY_CRITIC_ENABLED=false
COOKIES_STRATEGY_ORGANIZATION_ALLOWLIST=

# Seed 2.1 Pro web research uses an encrypted `research.web` Ark Provider
# route. Run scripts/configure-seed-web-research.ps1 before enabling it.
COOKIES_RESEARCH_SEED_ENABLED=false
COOKIES_RESEARCH_SEED_MODEL_ALIAS=cookies.research.web.standard
# LAS PDF parsing remains off until a document.vision.parse route, encrypted
# credential, and the single shared TOS bucket are configured.
COOKIES_DOCUMENT_VISION_ENABLED=false
COOKIES_DOCUMENT_VISION_MODEL_ALIAS=cookies.document.vision.standard
COOKIES_DOCUMENT_CONVERTER_ENABLED=false
COOKIES_DOCUMENT_CONVERTER_BASE_URL=http://127.0.0.1:3000
COOKIES_DOCUMENT_CONVERTER_VERSION=gotenberg-8.34.0
COOKIES_DOCUMENT_CONVERTER_TIMEOUT_SECONDS=120
COOKIES_DOCUMENT_CONVERTER_MAX_PDF_BYTES=33554432
COOKIES_DOCUMENT_CONVERTER_ALLOW_INSECURE_HTTP=false
COOKIES_RESEARCH_MAX_CONCURRENT=3
# Optional asynchronous parser for DOCX/PDF uploads. The pinned minimal image
# intentionally excludes OCR; run `docker compose up -d tika` before enabling.
COOKIES_RESEARCH_TIKA_ENABLED=false
COOKIES_RESEARCH_TIKA_BASE_URL=http://127.0.0.1:9998
COOKIES_RESEARCH_TIKA_VERSION=3.2.3.0
COOKIES_RESEARCH_TIKA_TIMEOUT_SECONDS=120
COOKIES_RESEARCH_TIKA_MAX_OUTPUT_BYTES=20971520

# Local development defaults. The fixed key is intentionally public and must
# never be used outside local development; keep it stable while local MySQL
# contains encrypted Miyun sessions. Never place a session cookie in this file.
COOKIES_MIYUN_ENABLED=true
COOKIES_MIYUN_ENDPOINT=https://api.youshu.youcloud.com/graphql
COOKIES_MIYUN_MASTER_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
COOKIES_MIYUN_MASTER_KEY_VERSION=v1
# This is the verified API host used for connection checks. Add only verified
# media CDN hostnames here before exercising material import or preview.
COOKIES_MIYUN_DOWNLOAD_ALLOWED_HOSTS=api.youshu.youcloud.com,creative-static-ag-v2.umcdn.cn
COOKIES_MIYUN_MAX_CONCURRENT=1
COOKIES_MIYUN_REQUESTS_PER_SECOND=5
COOKIES_MIYUN_COOLDOWN_SECONDS=300
# To use MiniMax-M2.7 for local Strategy generation, run
# .\scripts\configure-minimax-text.ps1. It asks for the API key securely,
# stores only encrypted credential material in MySQL, and enables the three
# settings above without putting the key in this file.
# For adapter_gateway, model routes and encrypted service tokens live in
# MySQL. This base64 value must decode to 32 bytes and must not be stored in DB.
# Generate a fresh value locally; keep it stable while local MySQL data exists.
COOKIES_PROVIDER_MASTER_KEY=
COOKIES_PROVIDER_MASTER_KEY_VERSION=v1
# Temporary local integration only. Staging/production reject this setting.
COOKIES_PROVIDER_ALLOW_INSECURE_HTTP=false
COOKIES_ARK_IMAGE_API_KEY=
COOKIES_ARK_IMAGE_MODEL=
COOKIES_ARK_IMAGE_BASE_URL=

# Seedance video generation is Adapter-only. Import or configure an encrypted
# adapter_gateway video route, then set COOKIES_PROVIDER_VIDEO_ADAPTER above to
# adapter_gateway. Do not place the Adapter token in this file.

# Ark text generation is also local-only and server-side. Set ark_text only
# after adding credentials to an ignored local .env file.
COOKIES_PROVIDER_TEXT_ADAPTER=fake
COOKIES_ARK_TEXT_API_KEY=
COOKIES_ARK_TEXT_MODEL=
COOKIES_ARK_TEXT_BASE_URL=

# OpenAI-compatible image gateway. Base URL may include /v1 when that is the
# gateway's documented API base.
COOKIES_OPENAI_IMAGE_API_KEY=
COOKIES_OPENAI_IMAGE_MODEL=gpt-image-2
COOKIES_OPENAI_IMAGE_BASE_URL=

# Volcengine recording-file recognition is shared by Creative reference-video
# analysis and the generic media-understanding runtime. Keep credentials only
# in an ignored .env or the deployment secret store.
# Old-console accounts use legacy + APP ID + Access Token. New-console
# accounts use api_key + API Key instead.
COOKIES_VOLCENGINE_ASR_ENDPOINT=https://openspeech.bytedance.com/api/v3/auc/bigmodel/recognize/flash
COOKIES_VOLCENGINE_ASR_AUTH_MODE=legacy
COOKIES_VOLCENGINE_ASR_APP_ID=
COOKIES_VOLCENGINE_ASR_ACCESS_TOKEN=
COOKIES_VOLCENGINE_ASR_API_KEY=
COOKIES_VOLCENGINE_ASR_RESOURCE_ID=volc.bigasr.auc_turbo
COOKIES_VOLCENGINE_ASR_MODEL=bigmodel

# Investor-demo TypeScript server compatibility. These variables are consumed
# by server/ark-provider.ts, separately from the Go Provider settings above.
# Server-only Ark credential. Leave empty to run the seeded walkthrough without AI generation.
# Never commit a populated .env file or paste a credential into browser settings.
ARK_API_KEY=

# Optional Ark-compatible API base URL. The default HTTPS endpoint is used when omitted.
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
