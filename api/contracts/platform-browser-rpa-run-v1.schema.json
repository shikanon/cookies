{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shikanon/cookies/api/contracts/platform-browser-rpa-run-v1.schema.json",
  "title": "Platform Browser RPA Run v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "organization_id", "project_id", "platform", "account_id", "authority", "environment_id", "profile_id", "lease_id", "policy_id", "state", "paused", "takeover_active", "version", "idempotency_key", "request_hash", "created_by", "created_at", "updated_at"],
  "properties": {
    "schema_version": { "const": "browser-rpa-run/v1" },
    "id": { "type": "string", "minLength": 1 },
    "organization_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "platform": { "const": "ocean_engine" },
    "account_id": { "type": "string", "minLength": 1 },
    "authority": { "$ref": "#/$defs/authority" },
    "environment_id": { "type": "string", "minLength": 1 },
    "profile_id": { "type": "string", "minLength": 1 },
    "lease_id": { "type": "string", "minLength": 1 },
    "policy_id": { "type": "string", "minLength": 1 },
    "state": { "enum": ["queued", "environment_check", "awaiting_takeover", "preparing", "awaiting_confirmation", "submitting", "verifying", "succeeded", "failed", "partial", "result_unknown", "cancelled"] },
    "blocking_reason": { "$ref": "#/$defs/blockingReason" },
    "paused": { "type": "boolean" },
    "takeover_active": { "type": "boolean" },
    "version": { "type": "integer", "minimum": 1 },
    "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 255 },
    "request_hash": { "$ref": "#/$defs/hash" },
    "created_by": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "blockingReason": {
      "enum": ["FINAL_CONFIRMATION_REQUIRED", "FINAL_CONFIRMATION_INVALID", "APPROVAL_INVALID", "LEASE_INVALID", "KILL_SWITCH_ACTIVE", "ACCOUNT_MISMATCH", "PROJECT_NOT_ALLOWED", "SITE_NOT_ALLOWED", "PAGE_DRIFT", "RUNNER_FAILURE", "WORKFLOW_DRIFT", "SKILL_DRIFT", "RESULT_RECONCILIATION_REQUIRED"]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "organization_id", "project_id", "business_execution_id", "change_set_id", "approval_id", "approval_action_hash", "account_reference_id", "object_fingerprint", "action", "budget_limit_minor", "currency", "plan_canonical_hash", "intent_canonical_hash", "feedback_canonical_hash", "decision_canonical_hash", "configuration_canonical_hash", "workflow_id", "workflow_canonical_hash", "workflow_step_id"],
      "dependentRequired": {
        "skill_id": ["skill_version"],
        "skill_version": ["skill_id"]
      },
      "properties": {
        "schema_version": { "const": "browser-rpa-authority/v1" },
        "organization_id": { "type": "string", "minLength": 1 },
        "project_id": { "type": "string", "minLength": 1 },
        "business_execution_id": { "type": "string", "minLength": 1 },
        "change_set_id": { "type": "string", "minLength": 1 },
        "approval_id": { "type": "string", "minLength": 1 },
        "approval_action_hash": { "$ref": "#/$defs/hash" },
        "account_reference_id": { "type": "string", "minLength": 1 },
        "parent_platform_project_id": { "type": "string", "minLength": 1 },
        "target_mapping_id": { "type": "string", "minLength": 1 },
        "target_mapping_version": { "type": "integer", "minimum": 1 },
        "target_platform_object_id": { "type": "string", "minLength": 1 },
        "target_platform_object_kind": { "const": "promotion" },
        "operator_principal_id": { "type": "string", "minLength": 1 },
        "supersedes_controlled_change_set_id": { "type": "string", "minLength": 1 },
        "promotion_mutation": { "$ref": "#/$defs/promotionMutation" },
        "promotion_control": { "$ref": "#/$defs/promotionControl" },
        "promotion_restart": { "$ref": "#/$defs/promotionRestart" },
        "object_fingerprint": { "type": "string", "minLength": 1 },
        "action": { "enum": ["create_project_and_promotions", "create_promotions_in_existing_project", "update_promotion_budget", "update_promotion_materials", "pause_promotion", "resume_promotion"] },
        "project_budget_mode": { "enum": ["daily", "unlimited"] },
        "project_budget_limit_minor": { "type": "integer", "minimum": 0 },
        "promotion_budget_limit_minor": { "type": "integer", "minimum": 0 },
        "budget_limit_minor": { "type": "integer", "minimum": 0 },
        "currency": { "const": "CNY" },
        "plan_canonical_hash": { "$ref": "#/$defs/hash" },
        "intent_canonical_hash": { "$ref": "#/$defs/hash" },
        "feedback_canonical_hash": { "$ref": "#/$defs/hash" },
        "decision_canonical_hash": { "$ref": "#/$defs/hash" },
        "configuration_canonical_hash": { "$ref": "#/$defs/hash" },
        "workflow_id": { "type": "string", "minLength": 1 },
        "workflow_canonical_hash": { "$ref": "#/$defs/hash" },
        "workflow_step_id": { "type": "string", "minLength": 1 },
        "skill_id": { "type": "string", "minLength": 1 },
        "skill_version": { "type": "string", "minLength": 1 }
      }
    },
    "scheduleWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_at", "end_at", "timezone"],
      "properties": {
        "start_at": { "type": "string", "format": "date-time" },
        "end_at": { "type": "string", "format": "date-time" },
        "timezone": { "type": "string", "minLength": 1 }
      }
    },
    "materialReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_id", "authorization_evidence_id"],
      "properties": {
        "reference_id": { "type": "string", "minLength": 1 },
        "authorization_evidence_id": { "type": "string", "minLength": 1 }
      }
    },
    "landingPageReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_id", "authorization_evidence_id"],
      "properties": {
        "reference_id": { "type": "string", "minLength": 1 },
        "authorization_evidence_id": { "type": "string", "minLength": 1 }
      }
    },
    "promotionMutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_daily_budget_minor", "target_daily_budget_minor", "current_state_hash", "target_state_hash"],
      "properties": {
        "current_daily_budget_minor": { "type": "integer", "minimum": 30000 },
        "target_daily_budget_minor": { "type": "integer", "minimum": 30000 },
        "current_materials": { "type": "array", "items": { "$ref": "#/$defs/materialReference" } },
        "target_materials": { "type": "array", "items": { "$ref": "#/$defs/materialReference" } },
        "current_state_hash": { "$ref": "#/$defs/hash" },
        "target_state_hash": { "$ref": "#/$defs/hash" }
      }
    },
    "promotionControl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_daily_budget_minor", "current_platform_status", "target_platform_status", "current_state_hash", "target_state_hash"],
      "properties": {
        "current_daily_budget_minor": { "type": "integer", "minimum": 30000 },
        "current_platform_status": { "const": "delivering" },
        "target_platform_status": { "const": "paused" },
        "current_state_hash": { "$ref": "#/$defs/hash" },
        "target_state_hash": { "$ref": "#/$defs/hash" }
      }
    },
    "promotionRestart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_daily_budget_minor", "approved_daily_budget_minor", "current_platform_status", "target_platform_status", "schedule", "materials", "landing_page", "current_state_hash", "target_state_hash"],
      "properties": {
        "current_daily_budget_minor": { "type": "integer", "minimum": 30000 },
        "approved_daily_budget_minor": { "type": "integer", "minimum": 30000 },
        "current_platform_status": { "const": "paused" },
        "target_platform_status": { "const": "delivering" },
        "schedule": { "$ref": "#/$defs/scheduleWindow" },
        "materials": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/materialReference" } },
        "landing_page": { "$ref": "#/$defs/landingPageReference" },
        "current_state_hash": { "$ref": "#/$defs/hash" },
        "target_state_hash": { "$ref": "#/$defs/hash" }
      }
    }
  }
}
