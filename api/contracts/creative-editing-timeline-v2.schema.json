{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cookies.local/contracts/creative-editing-timeline-v2.schema.json",
  "title": "Creative Editing Timeline v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "timebase", "canvas", "duration_frames", "tracks"],
  "properties": {
    "schema_version": { "const": "editing-timeline/v2" },
    "timebase": { "type": "object", "additionalProperties": false, "required": ["frame_rate_num", "frame_rate_den"], "properties": { "frame_rate_num": { "const": 30 }, "frame_rate_den": { "const": 1 } } },
    "canvas": { "$ref": "#/$defs/canvas" },
    "duration_frames": { "type": "integer", "minimum": 1 },
    "tracks": { "type": "array", "minItems": 1, "items": { "oneOf": [{ "$ref": "#/$defs/visual_track" }, { "$ref": "#/$defs/caption_track" }, { "$ref": "#/$defs/audio_track" }] } }
  },
  "$defs": {
    "asset_ref": { "type": "object", "additionalProperties": false, "required": ["asset_id", "version"], "properties": { "asset_id": { "type": "string", "minLength": 1 }, "version": { "type": "integer", "minimum": 1 } } },
    "timeline": { "type": "object", "additionalProperties": false, "required": ["start_frame", "duration_frames"], "properties": { "start_frame": { "type": "integer", "minimum": 0 }, "duration_frames": { "type": "integer", "minimum": 1 } } },
    "source": { "type": "object", "additionalProperties": false, "required": ["in_us", "out_us"], "properties": { "in_us": { "type": "integer", "minimum": 0 }, "out_us": { "type": "integer", "minimum": 1 } } },
    "canvas": { "type": "object", "additionalProperties": false, "required": ["profile_id", "width", "height", "sample_rate", "background"], "properties": { "profile_id": { "enum": ["vertical-720p-v1", "landscape-720p-v1", "square-1080-v1"] }, "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 }, "sample_rate": { "const": 48000 }, "background": { "type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": { "type": { "const": "color" }, "value": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" } } } } },
    "crop": { "type": "object", "additionalProperties": false, "required": ["left", "top", "right", "bottom"], "properties": { "left": { "type": "number", "minimum": 0, "maximum": 1 }, "top": { "type": "number", "minimum": 0, "maximum": 1 }, "right": { "type": "number", "minimum": 0, "maximum": 1 }, "bottom": { "type": "number", "minimum": 0, "maximum": 1 } } },
    "transform": { "type": "object", "additionalProperties": false, "required": ["fit", "position_x", "position_y", "scale", "crop", "opacity"], "properties": { "fit": { "enum": ["contain", "cover"] }, "position_x": { "type": "number", "minimum": 0, "maximum": 1 }, "position_y": { "type": "number", "minimum": 0, "maximum": 1 }, "scale": { "type": "number", "exclusiveMinimum": 0, "maximum": 20 }, "crop": { "$ref": "#/$defs/crop" }, "opacity": { "type": "number", "minimum": 0, "maximum": 1 } } },
    "original_audio": { "type": "object", "additionalProperties": false, "required": ["enabled", "gain_db", "fade_in_frames", "fade_out_frames"], "properties": { "enabled": { "type": "boolean" }, "gain_db": { "type": "number", "minimum": -96, "maximum": 24 }, "fade_in_frames": { "type": "integer", "minimum": 0 }, "fade_out_frames": { "type": "integer", "minimum": 0 } } },
    "video_clip": { "type": "object", "additionalProperties": false, "required": ["id", "kind", "asset_ref", "timeline", "source", "transform", "original_audio"], "properties": { "id": { "type": "string", "minLength": 1 }, "kind": { "const": "video" }, "asset_ref": { "$ref": "#/$defs/asset_ref" }, "timeline": { "$ref": "#/$defs/timeline" }, "source": { "$ref": "#/$defs/source" }, "transform": { "$ref": "#/$defs/transform" }, "original_audio": { "$ref": "#/$defs/original_audio" } } },
    "image_clip": { "type": "object", "additionalProperties": false, "required": ["id", "kind", "asset_ref", "timeline", "transform"], "properties": { "id": { "type": "string", "minLength": 1 }, "kind": { "const": "image" }, "asset_ref": { "$ref": "#/$defs/asset_ref" }, "timeline": { "$ref": "#/$defs/timeline" }, "transform": { "$ref": "#/$defs/transform" } } },
    "caption_clip": { "type": "object", "additionalProperties": false, "required": ["id", "kind", "timeline", "text", "style_ref"], "properties": { "id": { "type": "string", "minLength": 1 }, "kind": { "const": "caption" }, "timeline": { "$ref": "#/$defs/timeline" }, "text": { "type": "string", "minLength": 1 }, "style_ref": { "type": "object", "additionalProperties": false, "required": ["style_id", "version"], "properties": { "style_id": { "type": "string", "minLength": 1 }, "version": { "type": "integer", "minimum": 1 } } }, "emphasis": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["start_rune", "end_rune"], "properties": { "start_rune": { "type": "integer", "minimum": 0 }, "end_rune": { "type": "integer", "minimum": 1 } } } } } },
    "audio_clip": { "type": "object", "additionalProperties": false, "required": ["id", "kind", "asset_ref", "timeline", "source", "gain_db", "fade_in_frames", "fade_out_frames", "loop"], "properties": { "id": { "type": "string", "minLength": 1 }, "kind": { "const": "audio" }, "asset_ref": { "$ref": "#/$defs/asset_ref" }, "timeline": { "$ref": "#/$defs/timeline" }, "source": { "$ref": "#/$defs/source" }, "gain_db": { "type": "number", "minimum": -96, "maximum": 24 }, "fade_in_frames": { "type": "integer", "minimum": 0 }, "fade_out_frames": { "type": "integer", "minimum": 0 }, "loop": { "type": "boolean" } } },
    "visual_track": { "type": "object", "additionalProperties": false, "required": ["id", "kind", "role", "z_index", "muted", "locked", "clips"], "properties": { "id": { "type": "string", "minLength": 1 }, "kind": { "const": "visual" }, "role": { "enum": ["primary", "overlay"] }, "z_index": { "type": "integer", "minimum": 0, "maximum": 2 }, "muted": { "type": "boolean" }, "locked": { "type": "boolean" }, "hidden": { "type": "boolean" }, "clips": { "type": "array", "items": { "oneOf": [{ "$ref": "#/$defs/video_clip" }, { "$ref": "#/$defs/image_clip" }] } } } },
    "caption_track": { "type": "object", "additionalProperties": false, "required": ["id", "kind", "language", "clips"], "properties": { "id": { "type": "string", "minLength": 1 }, "kind": { "const": "caption" }, "language": { "type": "string", "minLength": 2 }, "clips": { "type": "array", "items": { "$ref": "#/$defs/caption_clip" } } } },
    "audio_track": { "type": "object", "additionalProperties": false, "required": ["id", "kind", "role", "muted", "clips"], "properties": { "id": { "type": "string", "minLength": 1 }, "kind": { "const": "audio" }, "role": { "enum": ["voiceover", "music", "sfx"] }, "muted": { "type": "boolean" }, "clips": { "type": "array", "items": { "$ref": "#/$defs/audio_clip" } } } }
  }
}
