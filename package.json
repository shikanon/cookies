{
  "name": "cookies-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test test/*.test.ts",
    "contract:check": "tsx --test test/strategy-creative-contracts.test.ts test/delivery-platform-configuration-contract.test.ts && go test ./internal/platform/contract ./internal/integrations/strategycreative ./internal/systems/delivery",
    "go:migrate": "go run ./cmd/cookies-migrate",
    "go:seed": "go run ./cmd/cookies-seed",
    "server": "tsx --env-file=.env server/index.ts",
    "test:server": "tsx --test server/*.test.* server/test/*.test.*",
    "test:media-status": "tsx --test server/test/media-status.test.ts",
    "check:server": "tsc --noEmit -p server/tsconfig.json",
    "test:e2e": "playwright test --config=playwright.platform.config.ts",
    "test:e2e:platform": "playwright test --config=playwright.platform.config.ts",
    "test:e2e:legacy": "playwright test"
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "lucide-react": "0.564.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router-dom": "^7.18.1",
    "vite": "6.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.23.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.16"
  }
}
